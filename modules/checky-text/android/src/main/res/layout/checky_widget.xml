<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/checky_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/checky_w_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:text="@string/checky_widget_title"
        android:textColor="#0A0A0B"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/checky_w_verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/checky_widget_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/checky_widget_verify"
        android:textColor="#F3F2EE"
        android:textSize="13sp"
        android:textStyle="bold" />
  </LinearLayout>

  <TextView
      android:id="@+id/checky_w_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/checky_widget_empty"
      android:textColor="#55544E"
      android:textSize="13sp" />

  <include layout="@layout/checky_widget_row0" />
  <include layout="@layout/checky_widget_row1" />
  <include layout="@layout/checky_widget_row2" />
</LinearLayout>
