<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.checkytext" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>

        <!-- « Checky » in the text-selection menu: checks the selected text. -->
        <activity
            android:name="expo.modules.checkytext.ProcessTextActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/checky_menu_check"
            android:theme="@style/Theme.CheckySheet"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity> <!-- « Remplacer par le démenti »: a rumour being written becomes the published démenti and its link. -->
        <activity-alias
            android:name="expo.modules.checkytext.DebunkText"
            android:exported="true"
            android:label="@string/checky_menu_debunk"
            android:targetActivity="expo.modules.checkytext.ProcessTextActivity" >
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias> <!-- « Traduire FR ↔ MG »: on text being written, the translation replaces the selection. -->
        <activity-alias
            android:name="expo.modules.checkytext.TranslateText"
            android:exported="true"
            android:label="@string/checky_menu_translate"
            android:targetActivity="expo.modules.checkytext.ProcessTextActivity" >
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="expo.modules.checkytext.CheckWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>