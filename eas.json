{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://checky-mg.vercel.app",
        "EXPO_PUBLIC_API_URL": "https://fanilo-api.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://checky-mg.vercel.app",
        "EXPO_PUBLIC_API_URL": "https://fanilo-api.onrender.com"
      }
    }
  }
}
